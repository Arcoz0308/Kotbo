generator client {
  provider = "prisma-client-js"
  engineType = "library"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}


model Guild {
  id String @id

  configChannelId String?
  regulationChannelId String?
  regulationMessageId String?
  publicChannelId String?
  digestChannelId String?
  meetingAnnouncementChannelId String?
  meetingVoiceChannelId String?

  youtubeEnabled    Boolean @default(false)
  nathanYtChannelId String?
  nathanChannelId   String? 
  youtubeChannelId  String? 
  youtubeShortRoleId String?
  youtubeVideoRoleId String?

  moderatorRoleId   String?
  baseStaffRoleId   String?
  testStaffRoleId   String?

  recruitmentCategoryId  String?
  recruitmentLogChannelId String?

  digestEnabled    Boolean         @default(false)
  digestFrequency  DigestFrequency @default(DAILY)
  digestTime       String          @default("08:00") // HH:MM
  digestCount      Int             @default(10)
  digestRoleId     String?         
  digestCustomText String?         

  translationEnabled Boolean @default(false)
  defaultTranslateTo String  @default("FR")

  globalIncludeKeywords String[] @default([])
  globalExcludeKeywords String[] @default([])
  globalIgnoredKeywords String[] @default([])
  preferencesMigrated Boolean @default(false)

  codePoliceEnabled        Boolean @default(false)
  codePoliceRules          CodePoliceRule[]
  
  dailyAlgoEnabled         Boolean @default(false)
  dailyAlgoChannelId       String?
  dailyAlgoValidationChannelId String?
  dailyAlgoTime            String  @default("09:00") // HH:MM
  
  githubReleasesEnabled    Boolean @default(false)
  githubReleasesChannelId  String?
  githubRepositories       String[] @default(["facebook/react", "docker/compose", "microsoft/typescript", "vercel/next.js", "sveltejs/svelte"])
  
  statusCheckChannelId     String?
  logChannelId             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeds        Feed[]
  youtubeItems YouTubeItem[]
  youtubeSubscriptions YouTubeSubscription[]
  dailyAlgoRuns DailyAlgoRun[]
  interestTopics InterestTopicScore[]
  interestFeedback NewsInterestFeedback[]
  dashboardSettings DashboardSettings?
  dashboardAuditLogs DashboardAuditLog[]
  sanctions Sanction[]
  sanctionReports SanctionReport[]
  regulationArticles GuildRegulationArticle[]
  memberProfiles MemberProfile[]
  staffMembers StaffMember[] @relation("GuildStaffMembers")
  staffRoles StaffRole[] @relation("GuildStaffRoles")
  staffAbsences StaffAbsence[]
  staffMeetings StaffMeeting[]
  staffManagerNotes StaffManagerNote[]
  staffPolls StaffPoll[]
  staffProcedures StaffProcedure[]
  candidatures RecruitmentCandidature[]

  @@map("guilds")
}

model GuildRegulationArticle {
  id String @id @default(cuid())

  guildId String
  title String
  description String
  emoji String?
  sortOrder Int @default(0)
  enabled Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_regulation_articles")
  @@index([guildId, enabled, sortOrder])
}

model DashboardSettings {
  guildId String @id

  email String @default("")
  emailEnabled Boolean @default(false)
  cloudBackup Boolean @default(true)
  debugLog Boolean @default(false)
  killSwitchEnabled Boolean @default(false)
  severityByModule Json?
  commandRestrictions Json?
  messageTemplate String @default("🔔 {titre}\n\n{resume}\n\nSource: {source}\nAuteur: {auteur}\n\nPublié automatiquement par Kotbo.")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_settings")
}

model DashboardAuditLog {
  id String @id @default(cuid())

  guildId String
  channelId String?
  user String
  action String
  context String
  module String
  eventType String
  details String
  dateIso DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, dateIso])
  @@map("dashboard_audit_logs")
}

model CodePoliceRule {
  id String @id @default(cuid())

  key String @unique
  guildId String?

  category CodePoliceRuleCategory
  matchType CodePoliceMatchType @default(EXACT)
  language String?
  pattern String
  label String
  feedback String
  severity CodePoliceSeverity @default(WARNING)
  enabled Boolean @default(true)

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("code_police_rules")
  @@index([guildId, category])
  @@index([category, enabled])
  @@index([language])
}

model Feed {
  id      String @id @default(cuid())
  guildId String

  name        String
  url         String
  category    String  @default("Général")
  enabled     Boolean @default(true)
  autoPublish Boolean @default(false)

  includeKeywords String[] @default([])
  excludeKeywords String[] @default([])
  ignoredKeywords String[] @default([])

  language    String?
  translateTo String?

  roleId   String?
  autoRole Boolean @default(false)

  guild       Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  items       FeedItem[]
  subscribers UserFeedSub[]

  lastPolledAt DateTime?
  lastPollError String?
  lastPollStatus String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([guildId, url])
  @@map("feeds")
}

model FeedItem {
  id     String @id @default(cuid())
  feedId String

  guid        String
  title       String
  url         String
  description String?
  imageUrl    String?
  author      String?
  publishedAt DateTime

  titleTranslated       String?
  descriptionTranslated String?

  status          ItemStatus @default(PENDING)
  interestDecision InterestDecision @default(ALLOWED)
  interestScore Float?
  interestReason String?
  topics String[] @default([])
  queueMessageId  String?
  publicMessageId String?
  pinned          Boolean    @default(false)

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feedId, guid])
  @@index([interestDecision, createdAt])
  @@map("feed_items")
}

model InterestTopicScore {
  id String @id @default(cuid())

  guildId String
  userId String @default("__guild__")
  topic String
  score Float @default(0)
  positiveCount Int @default(0)
  negativeCount Int @default(0)
  lastInteractedAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId, topic])
  @@index([guildId, userId])
  @@index([topic])
  @@map("interest_topic_scores")
}

model NewsInterestFeedback {
  id String @id @default(cuid())

  guildId String
  userId String?
  feedItemId String?
  topic String
  value Int
  source FeedbackSource

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([userId, createdAt])
  @@index([feedItemId])
  @@map("news_interest_feedback")
}

model YouTubeItem {
  id      String @id @default(cuid())
  guildId String

  videoId      String   @unique
  title        String
  description  String?
  channelName  String
  channelId    String
  thumbnailUrl String?
  isShort      Boolean  @default(false)
  publishedAt  DateTime

  status          ItemStatus @default(PENDING)
  queueMessageId  String?
  publicMessageId String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("youtube_items")
}

model YouTubeSubscription {
  id         String   @id @default(cuid())
  guildId    String
  channelId  String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([guildId, channelId])
  @@map("youtube_subscriptions")
}

model UserFeedSub {
  id     String @id @default(cuid())
  userId String
  feedId String

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, feedId])
  @@map("user_feed_subs")
}

model DeveloperExcuse {
  id        String   @id @default(cuid())
  text      String
  language  String   @default("fr")
  createdAt DateTime @default(now())

  @@map("developer_excuses")
  @@index([language])
}

model DailyAlgoProblem {
  id          String   @id @default(cuid())
  title       String
  description String
  solution    String
  difficulty  String   @default("moyen") // facile, moyen, difficile
  language    String   @default("fr")
  functionName String?
  functionArgs Json?
  unitTests Json?
  allowedLanguages String[] @default(["javascript"])
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs DailyAlgoRun[]

  @@map("daily_algo_problems")
  @@index([language])
  @@index([language, usedAt])
}

model DailyAlgoRun {
  id String @id @default(cuid())

  guildId String
  dateKey String?
  problemId String

  challengeChannelId String
  validationChannelId String?
  challengeMessageId String?
  leaderboardMessageId String?
  summarySentAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  problem DailyAlgoProblem @relation(fields: [problemId], references: [id])
  submissions DailyAlgoSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_algo_runs")
  @@index([guildId, createdAt])
  @@unique([guildId, dateKey])
}

model DailyAlgoSubmission {
  id String @id @default(cuid())

  runId String
  authorId String
  authorName String
  solution String

  status DailyAlgoSubmissionStatus @default(PENDING)
  validationMessageId String?
  validatedById String?
  validatedAt DateTime?

  submittedAt DateTime @default(now())
  speedRank Int?
  speedBonusPoints Float?

  scoreCorrectness Int?
  scoreComments Int?
  scoreCompactness Int?
  scoreOptimization Int?
  scoreReadability Int?
  scoreFinal Float?
  reviewFeedback String?

  run DailyAlgoRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_algo_submissions")
  @@index([runId, status])
  @@index([authorId])
}

model Sanction {
  id String @id @default(cuid())

  guildId String
  type SanctionType
  status SanctionStatus @default(ACTIVE)

  targetUserId String
  targetTag String?
  moderatorUserId String
  moderatorTag String?

  reason String
  durationSeconds Int?
  expiresAt DateTime?
  nextActionAt DateTime?

  resolvedAt DateTime?
  resolutionNote String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reports SanctionReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, status, type])
  @@index([status, nextActionAt])
  @@map("sanctions")
}

model SanctionReport {
  id String @id @default(cuid())

  guildId String
  sanctionId String?

  staffPseudo String
  incidentAt DateTime
  memberPseudo String
  memberReference String

  sanctionType SanctionType
  sanctionDurationLabel String?
  brokenRules String
  detailedReason String
  evidenceLinks String[] @default([])
  additionalNotes String?

  createdByUserId String
  createdByTag String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sanction Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, sanctionType])
  @@index([sanctionId])
  @@map("sanction_reports")
}

model MemberProfile {
  id String @id @default(cuid())

  guildId String
  userId String

  userTag String?
  username String?
  globalName String?
  displayName String?
  avatarUrl String?
  bannerUrl String?
  accentColor Int?
  locale String?
  isBot Boolean @default(false)

  accountCreatedAt DateTime?
  guildJoinedAt DateTime?
  guildLeftAt DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  lastMessageAt DateTime?
  lastMessageChannelId String?
  messageCount Int @default(0)

  voiceSessionCount Int @default(0)
  voiceTimeSeconds Int @default(0)
  voiceLastChannelId String?
  voiceLastJoinedAt DateTime?
  voiceLastLeftAt DateTime?

  rolesSnapshot String[] @default([])

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, lastSeenAt])
  @@index([guildId, guildJoinedAt])
  @@map("member_profiles")
}

enum ItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InterestDecision {
  ALLOWED
  FILTERED_OUT
}

enum FeedbackSource {
  STAFF_APPROVE
  STAFF_REJECT
  USER_INTERESTING
  USER_NOT_INTERESTING
  RECOVERY_OVERRIDE
}

enum DailyAlgoSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DigestFrequency {
  DAILY
  WEEKLY
}

enum CodePoliceRuleCategory {
  SIGNAL
  DANGER
  LANGUAGE_FEEDBACK
}

enum CodePoliceMatchType {
  EXACT
  REGEX
}

enum CodePoliceSeverity {
  INFO
  WARNING
  DANGER
}

enum SanctionType {
  WARN
  KICK
  TIMEOUT
  TEMP_BAN
  BAN
}

enum SanctionStatus {
  ACTIVE
  RESOLVED
  FAILED
}

// ============================================================================
// SYSTÈME DE GESTION DU PERSONNEL
// ============================================================================

model StaffMember {
  id String @id @default(cuid())

  guildId String
  userId String

  grade String @default("Staff")
  joinedStaffAt DateTime @default(now())
  currentRoleStartedAt DateTime @default(now())

  userTag String?
  username String?
  displayName String?
  avatarUrl String?

  guild Guild @relation("GuildStaffMembers", fields: [guildId], references: [id], onDelete: Cascade)
  warnings StaffWarning[]
  blacklistEntries StaffBlacklist[]
  testingPeriods TestingPeriod[] @relation("StaffMemberTestingPeriods")
  mentoredMembers TestingPeriod[] @relation("StaffMemberMentor")
  mentorReports MentorReport[]
  apiKeys APIKey[]
  activities StaffActivity[]
  absences StaffAbsence[]
  meetingPresences StaffMeetingPresence[]
  managerNotesAbout StaffManagerNote[] @relation("ManagerNotesAbout")
  managerNotesWritten StaffManagerNote[] @relation("ManagerNotesWritten")
  pollsCreated StaffPoll[]
  pollVotes StaffPollVote[]
  procedureReads StaffProcedureRead[]

  isTutor Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, grade])
  @@index([guildId, joinedStaffAt])
  @@map("staff_members")
}

model StaffRole {
  id String @id @default(cuid())

  guildId String
  name String
  level Int @default(0) // 0 = Helper, 1 = Mod, etc.
  discordRoleId String?
  color String? // Couleur optionnelle
  sortOrder Int @default(0)
  enabled Boolean @default(true)

  guild Guild @relation("GuildStaffRoles", fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId, level])
  @@map("staff_roles")
}

model StaffWarning {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  issuedByUserId String

  reason String
  type String @default("staff_warning") // Type de warn staff
  expiresAt DateTime? // null = permanent
  isActive Boolean @default(true)

  notes String?

  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId, isActive])
  @@index([guildId, expiresAt])
  @@map("staff_warnings")
}

model StaffBlacklist {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  issuedByUserId String

  reason String
  startDate DateTime @default(now())
  endDate DateTime? // null = indéterminé/permanent
  isActive Boolean @default(true)

  notes String?

  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId, isActive])
  @@index([guildId, isActive, endDate])
  @@map("staff_blacklist")
}

model TestingPeriod {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  mentorId String?

  startDate DateTime @default(now())
  endDate DateTime?
  status TestingPeriodStatus @default(ONGOING) // ONGOING, PASSED, FAILED
  
  plannedDurationDays Int @default(14)
  targetGrade String?

  notes String?

  staffMember StaffMember @relation("StaffMemberTestingPeriods", fields: [staffUserId], references: [id], onDelete: Cascade)
  mentor StaffMember? @relation("StaffMemberMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  reports MentorReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId, status])
  @@index([mentorId, status])
  @@map("testing_periods")
}

enum TestingPeriodStatus {
  ONGOING
  PASSED
  FAILED
}

model MentorReport {
  id String @id @default(cuid())

  testingPeriodId String
  authorId String

  type MentorReportType // POSITIVE, NEGATIVE, NEUTRAL
  content String
  createdAt DateTime @default(now())

  testingPeriod TestingPeriod @relation(fields: [testingPeriodId], references: [id], onDelete: Cascade)
  author StaffMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([testingPeriodId])
  @@map("mentor_reports")
}

enum MentorReportType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

model APIKey {
  id String @id @default(cuid())

  guildId String
  createdByUserId String
  keyHash String @unique // SHA256 du vrai clé
  displayKey String @unique // Les premiers/derniers 8 chars pour affichage (format: aab...xyz)

  name String @default("Mon clé API")
  permissions String[] @default(["daily_algo:create_exercise"]) // permissions supportées
  isActive Boolean @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy StaffMember @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([guildId, createdByUserId])
  @@map("api_keys")
}

model StaffActivity {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  
  activityDate DateTime // Date de l'activité (format: YYYY-MM-DD)
  messageCount Int @default(0)
  voiceMinutes Int @default(0)
  
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, staffUserId, activityDate])
  @@index([guildId, activityDate])
  @@map("staff_activities")
}

// ============================================================================
// OUTILS DE GESTION STAFF (Absences, Réunions, Notes, Polls, Procédures)
// ============================================================================

model StaffAbsence {
  id String @id @default(cuid())

  guildId String
  staffUserId String

  startDate DateTime
  endDate DateTime
  reason String
  status AbsenceStatus @default(PENDING)
  isVoid Boolean @default(false)
  
  decisionByUserId String?
  decisionNote String?

  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId])
  @@index([guildId, status])
  @@map("staff_absences")
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model StaffMeeting {
  id String @id @default(cuid())

  guildId String
  title String
  description String?
  scheduledAt DateTime
  status MeetingStatus @default(SCHEDULED)
  createdByUserId String
  
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  presences StaffMeetingPresence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, scheduledAt])
  @@map("staff_meetings")
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

model StaffMeetingPresence {
  id String @id @default(cuid())

  meetingId String
  staffUserId String
  status PresenceStatus @default(ABSENT)
  checkInAt DateTime?
  note String?

  meeting StaffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, staffUserId])
  @@map("staff_meeting_presences")
}

enum PresenceStatus {
  PRESENT
  EXCUSED
  ABSENT
}

model StaffManagerNote {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  authorUserId String // StaffMember author
  content String
  
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation("ManagerNotesAbout", fields: [staffUserId], references: [id], onDelete: Cascade)
  author StaffMember @relation("ManagerNotesWritten", fields: [authorUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffUserId])
  @@index([guildId])
  @@map("staff_manager_notes")
}

model StaffPoll {
  id String @id @default(cuid())

  guildId String
  authorUserId String
  title String
  description String?
  isAnonymous Boolean @default(true)
  closesAt DateTime?
  status PollStatus @default(OPEN)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  author StaffMember @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  options StaffPollOption[]
  votes StaffPollVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@map("staff_polls")
}

enum PollStatus {
  OPEN
  CLOSED
}

model StaffPollOption {
  id String @id @default(cuid())

  pollId String
  text String
  sortOrder Int @default(0)

  poll StaffPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes StaffPollVote[]

  @@map("staff_poll_options")
}

model StaffPollVote {
  id String @id @default(cuid())

  pollId String
  optionId String
  staffUserId String
  weight Float @default(1.0)

  poll StaffPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option StaffPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, staffUserId])
  @@map("staff_poll_votes")
}

model StaffProcedure {
  id String @id @default(cuid())

  guildId String
  title String
  content String
  sortOrder Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reads StaffProcedureRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, sortOrder])
  @@map("staff_procedures")
}

model StaffProcedureRead {
  id String @id @default(cuid())

  procedureId String
  staffUserId String
  readAt DateTime @default(now())

  procedure StaffProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([procedureId, staffUserId])
  @@map("staff_procedure_reads")
}

enum CandidatureStatus {
  PENDING
  ORAL
  APPROVED
  REJECTED
  AUTO_REJECTED
}

enum OralResult {
  PENDING
  PASSED
  FAILED
}

model RecruitmentCandidature {
  id String @id @default(cuid())
  guildId String
  
  // Identifying fields (can be submitted or parsed)
  discordId String?
  username String?
  email String?
  
  status CandidatureStatus @default(PENDING)
  
  // The raw submission from Google Forms / Webhook
  data Json
  
  // Internal notes from staff
  notes String?
  
  // Rejection
  rejectionReason String?
  autoRejected    Boolean @default(false)
  autoRejectReason String?
  
  // Oral interview
  oralResult    OralResult?
  oralNotes     String?
  
  // Ticket Discord
  ticketChannelId String?
  
  // Staff linkage (after acceptance)
  assignedTutorId  String?
  staffMemberId    String?
  
  // Reapply cooldown
  reapplyAfter DateTime?
  
  // Who processed this candidature
  processedByUserId String?
  
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@index([guildId, discordId])
  @@map("recruitment_candidatures")
}
