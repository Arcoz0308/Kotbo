generator client {
  provider = "prisma-client-js"
  engineType = "library"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}


model Guild {
  id String @id
  propagateSanctions Boolean @default(false)


  configChannelId String?
  regulationChannelId String?
  regulationMessageId String?
  publicChannelId String?
  digestChannelId String?
  meetingAnnouncementChannelId String?
  meetingVoiceChannelId String?



  moderatorRoleId   String?
  baseStaffRoleId   String?
  testStaffRoleId   String?

  recruitmentCategoryId  String?
  recruitmentLogChannelId String?

  digestEnabled    Boolean         @default(false)
  digestFrequency  DigestFrequency @default(DAILY)
  digestTime       String          @default("08:00") // HH:MM
  digestCount      Int             @default(10)
  digestRoleId     String?         
  digestCustomText String?         

  translationEnabled Boolean @default(false)
  defaultTranslateTo String  @default("FR")

  globalIncludeKeywords String[] @default([])
  globalExcludeKeywords String[] @default([])
  globalIgnoredKeywords String[] @default([])
  preferencesMigrated Boolean @default(false)

  codePoliceEnabled        Boolean @default(false)
  codePoliceRules          CodePoliceRule[]
  
  dailyAlgoEnabled         Boolean @default(false)
  dailyAlgoChannelId       String?
  dailyAlgoValidationChannelId String?
  dailyAlgoTime            String  @default("09:00") // HH:MM
  
  githubReleasesEnabled    Boolean @default(false)
  githubReleasesChannelId  String?
  githubRepositories       String[] @default(["facebook/react", "docker/compose", "microsoft/typescript", "vercel/next.js", "sveltejs/svelte"])
  
  statusCheckChannelId     String?
  logChannelId             String?

  // Configuration de la modération du personnel
  warnsToDemote               Int      @default(3)
  warnsToBlacklist            Int      @default(5)
  blacklistPermanentByDefault Boolean  @default(false)
  actionMode                  String   @default("MANUAL") // AUTO, MANUAL
  demoteRemoveAllRoles        Boolean  @default(false)

  sanctionSyncEnabled      Boolean @default(false)
  sanctionAlertChannelId   String?
  newsChannelId            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  newsArticles NewsArticle[]
  dailyAlgoRuns DailyAlgoRun[]
  dashboardSettings DashboardSettings?
  dashboardAuditLogs DashboardAuditLog[]
  sanctions Sanction[]
  sanctionReports SanctionReport[]
  regulationArticles GuildRegulationArticle[]
  memberProfiles MemberProfile[]
  staffMembers StaffMember[] @relation("GuildStaffMembers")
  staffRoles StaffRole[] @relation("GuildStaffRoles")
  staffAbsences StaffAbsence[]
  staffMeetings StaffMeeting[]
  staffManagerNotes StaffManagerNote[]
  staffPolls StaffPoll[]
  staffProcedures StaffProcedure[]
  candidatures RecruitmentCandidature[]
  notifications Notification[]
  guildDailyStats GuildDailyStat[]
  guildHourlyStats GuildHourlyStat[]
  channelDailyStats ChannelDailyStat[]
  memberDailyStats MemberDailyStat[]
  memberInvites MemberInvite[]
  guildInvites  GuildInvite[]
  linkedAccounts LinkedAccount[]

  tutoringConfig TutoringConfig?
  tutoringItems TutoringItem[]
  dashboardFeatureConfigs DashboardFeatureConfig[]

  @@map("guilds")
}

model GuildRegulationArticle {
  id String @id @default(cuid())

  guildId String
  title String
  description String
  emoji String?
  sortOrder Int @default(0)
  enabled Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_regulation_articles")
  @@index([guildId, enabled, sortOrder])
}

model DashboardSettings {
  guildId String @id

  email String @default("")
  emailEnabled Boolean @default(false)
  cloudBackup Boolean @default(true)
  debugLog Boolean @default(false)
  killSwitchEnabled Boolean @default(false)
  severityByModule Json?
  commandRestrictions Json?
  messageTemplate String @default("🔔 {titre}\n\n{resume}\n\nSource: {source}\nAuteur: {auteur}\n\nPublié automatiquement par Kotbo.")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_settings")
}

model DashboardAuditLog {
  id String @id @default(cuid())

  guildId String
  channelId String?
  user String
  action String
  context String
  module String
  eventType String
  details String
  dateIso DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([guildId, dateIso])
  @@map("dashboard_audit_logs")
}

model CodePoliceRule {
  id String @id @default(cuid())

  key String @unique
  guildId String?

  category CodePoliceRuleCategory
  matchType CodePoliceMatchType @default(EXACT)
  language String?
  pattern String
  label String
  feedback String
  severity CodePoliceSeverity @default(WARNING)
  enabled Boolean @default(true)

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("code_police_rules")
  @@index([guildId, category])
  @@index([category, enabled])
  @@index([language])
}

model NewsArticle {
  id String @id @default(cuid())

  guildId String
  title String
  content String
  summary String?
  imageUrl String?

  authorId String
  authorName String
  authorAvatar String?

  isGlobal Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  publishedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, publishedAt])
  @@index([isGlobal, publishedAt])
  @@map("news_articles")
}

model DeveloperExcuse {
  id        String   @id @default(cuid())
  text      String
  language  String   @default("fr")
  createdAt DateTime @default(now())

  @@map("developer_excuses")
  @@index([language])
}

model DailyAlgoProblem {
  id          String   @id @default(cuid())
  title       String
  description String
  solution    String
  difficulty  String   @default("moyen") // facile, moyen, difficile
  language    String   @default("fr")
  functionName String?
  functionArgs Json?
  unitTests Json?
  allowedLanguages String[] @default(["javascript"])
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs DailyAlgoRun[]

  @@map("daily_algo_problems")
  @@index([language])
  @@index([language, usedAt])
}

model DailyAlgoRun {
  id String @id @default(cuid())

  guildId String
  dateKey String?
  problemId String

  challengeChannelId String
  validationChannelId String?
  challengeMessageId String?
  leaderboardMessageId String?
  summarySentAt DateTime?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  problem DailyAlgoProblem @relation(fields: [problemId], references: [id])
  submissions DailyAlgoSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_algo_runs")
  @@index([guildId, createdAt])
  @@unique([guildId, dateKey])
}

model DailyAlgoSubmission {
  id String @id @default(cuid())

  runId String
  authorId String
  authorName String
  solution String

  status DailyAlgoSubmissionStatus @default(PENDING)
  validationMessageId String?
  validatedById String?
  validatedAt DateTime?

  submittedAt DateTime @default(now())
  speedRank Int?
  speedBonusPoints Float?

  scoreCorrectness Int?
  scoreComments Int?
  scoreCompactness Int?
  scoreOptimization Int?
  scoreReadability Int?
  scoreFinal Float?
  reviewFeedback String?

  run DailyAlgoRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_algo_submissions")
  @@index([runId, status])
  @@index([authorId])
}

model LinkedAccount {
  id String @id @default(cuid())
  guildId String
  
  user1Id String
  user2Id String
  
  type LinkedAccountType @default(MANUAL)
  status LinkedAccountStatus @default(VALIDATED)
  
  reason String?
  metadata Json? // Pour stocker les preuves de détection
  
  linkedByUserId String? // Si manuel, qui l'a fait
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, user1Id, user2Id])
  @@index([guildId, user1Id])
  @@index([guildId, user2Id])
  @@map("linked_accounts")
}

enum LinkedAccountType {
  MANUAL
  AUTOMATIC
}

enum LinkedAccountStatus {
  PENDING
  VALIDATED
  REJECTED
}

model Sanction {
  id String @id @default(cuid())

  guildId String
  type SanctionType
  status SanctionStatus @default(ACTIVE)

  targetUserId String
  targetTag String?
  moderatorUserId String
  moderatorTag String?

  reason String
  durationSeconds Int?
  expiresAt DateTime?
  nextActionAt DateTime?

  resolvedAt DateTime?
  resolutionNote String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reports SanctionReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, status, type])
  @@index([status, nextActionAt])
  @@map("sanctions")
}

model SanctionReport {
  id String @id @default(cuid())

  guildId String
  sanctionId String?

  staffPseudo String
  incidentAt DateTime
  memberPseudo String
  memberReference String

  sanctionType SanctionType
  sanctionDurationLabel String?
  brokenRules String
  detailedReason String
  evidenceLinks String[] @default([])
  additionalNotes String?

  createdByUserId String
  createdByTag String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sanction Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, sanctionType])
  @@index([sanctionId])
  @@map("sanction_reports")
}

model MemberProfile {
  id String @id @default(cuid())

  guildId String
  userId String

  userTag String?
  username String?
  globalName String?
  displayName String?
  avatarUrl String?
  bannerUrl String?
  accentColor Int?
  locale String?
  isBot Boolean @default(false)

  accountCreatedAt DateTime?
  guildJoinedAt DateTime?
  guildLeftAt DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  lastMessageAt DateTime?
  lastMessageChannelId String?
  messageCount Int @default(0)

  voiceSessionCount Int @default(0)
  voiceTimeSeconds Int @default(0)
  voiceLastChannelId String?
  voiceLastJoinedAt DateTime?
  voiceLastLeftAt DateTime?

  rolesSnapshot String[] @default([])

  isSuspectedDC Boolean @default(false)

  moderatorNote String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, lastSeenAt])
  @@index([guildId, guildJoinedAt])
  @@map("member_profiles")
}

enum ItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InterestDecision {
  ALLOWED
  FILTERED_OUT
}

enum FeedbackSource {
  STAFF_APPROVE
  STAFF_REJECT
  USER_INTERESTING
  USER_NOT_INTERESTING
  RECOVERY_OVERRIDE
}

enum DailyAlgoSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DigestFrequency {
  DAILY
  WEEKLY
}

enum CodePoliceRuleCategory {
  SIGNAL
  DANGER
  LANGUAGE_FEEDBACK
}

enum CodePoliceMatchType {
  EXACT
  REGEX
}

enum CodePoliceSeverity {
  INFO
  WARNING
  DANGER
}

enum SanctionType {
  WARN
  KICK
  TIMEOUT
  TEMP_BAN
  BAN
}

enum SanctionStatus {
  ACTIVE
  RESOLVED
  FAILED
}

// ============================================================================
// SYSTÈME DE GESTION DU PERSONNEL
// ============================================================================

model StaffMember {
  id String @id @default(cuid())

  guildId String
  userId String

  grade String @default("Staff")
  joinedStaffAt DateTime @default(now())
  currentRoleStartedAt DateTime @default(now())

  userTag String?
  username String?
  displayName String?
  avatarUrl String?

  guild Guild @relation("GuildStaffMembers", fields: [guildId], references: [id], onDelete: Cascade)
  warnings StaffWarning[]
  blacklistEntries StaffBlacklist[]
  testingPeriods TestingPeriod[] @relation("StaffMemberTestingPeriods")
  mentoredMembers TestingPeriod[] @relation("StaffMemberMentor")
  mentorReports MentorReport[]
  apiKeys APIKey[]
  activities StaffActivity[]
  absences StaffAbsence[]
  meetingPresences StaffMeetingPresence[]
  managerNotesAbout StaffManagerNote[] @relation("ManagerNotesAbout")
  managerNotesWritten StaffManagerNote[] @relation("ManagerNotesWritten")
  pollsCreated StaffPoll[]
  pollVotes StaffPollVote[]
  procedureReads StaffProcedureRead[]
  voiceSessions StaffVoiceSession[]

  isTutor Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, grade])
  @@index([guildId, joinedStaffAt])
  @@map("staff_members")
}

model StaffRole {
  id String @id @default(cuid())

  guildId String
  name String
  level Int @default(0) // 0 = Helper, 1 = Mod, etc.
  discordRoleId String?
  color String? // Couleur optionnelle
  sortOrder Int @default(0)
  enabled Boolean @default(true)

  guild Guild @relation("GuildStaffRoles", fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId, level])
  @@map("staff_roles")
}

model StaffWarning {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  issuedByUserId String

  reason String
  type String @default("staff_warning") // Type de warn staff
  expiresAt DateTime? // null = permanent
  isActive Boolean @default(true)

  notes String?

  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId, isActive])
  @@index([guildId, expiresAt])
  @@map("staff_warnings")
}

model StaffBlacklist {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  issuedByUserId String

  reason String
  startDate DateTime @default(now())
  endDate DateTime? // null = indéterminé/permanent
  isActive Boolean @default(true)

  notes String?

  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId, isActive])
  @@index([guildId, isActive, endDate])
  @@map("staff_blacklist")
}

model TestingPeriod {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  mentorId String?

  startDate DateTime @default(now())
  endDate DateTime?
  status TestingPeriodStatus @default(ONGOING) // ONGOING, PASSED, FAILED
  
  plannedDurationDays Int @default(14)
  targetGrade String?

  notes String?

  staffMember StaffMember @relation("StaffMemberTestingPeriods", fields: [staffUserId], references: [id], onDelete: Cascade)
  mentor StaffMember? @relation("StaffMemberMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  reports MentorReport[]

  lastReportAt DateTime?
  checklistProgress TutoringChecklistProgress[]
  logs TutoringLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId, status])
  @@index([mentorId, status])
  @@map("testing_periods")
}

enum TestingPeriodStatus {
  ONGOING
  PASSED
  FAILED
}

model MentorReport {
  id String @id @default(cuid())

  testingPeriodId String
  authorId String

  type MentorReportType // POSITIVE, NEGATIVE, NEUTRAL
  content String
  createdAt DateTime @default(now())

  testingPeriod TestingPeriod @relation(fields: [testingPeriodId], references: [id], onDelete: Cascade)
  author StaffMember @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([testingPeriodId])
  @@map("mentor_reports")
}

enum MentorReportType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

model APIKey {
  id String @id @default(cuid())

  guildId String
  createdByUserId String
  keyHash String @unique // SHA256 du vrai clé
  displayKey String @unique // Les premiers/derniers 8 chars pour affichage (format: aab...xyz)

  name String @default("Mon clé API")
  permissions String[] @default(["daily_algo:create_exercise"]) // permissions supportées
  isActive Boolean @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy StaffMember @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([guildId, createdByUserId])
  @@map("api_keys")
}

model StaffActivity {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  
  activityDate DateTime // Date de l'activité (format: YYYY-MM-DD)
  messageCount Int @default(0)
  voiceMinutes Int @default(0)
  
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, staffUserId, activityDate])
  @@index([guildId, activityDate])
  @@map("staff_activities")
}

// ============================================================================
// OUTILS DE GESTION STAFF (Absences, Réunions, Notes, Polls, Procédures)
// ============================================================================

model StaffAbsence {
  id String @id @default(cuid())

  guildId String
  staffUserId String

  startDate DateTime
  endDate DateTime?
  reason String
  type String @default("Autre")
  message String?
  isIndefinite Boolean @default(false)
  status AbsenceStatus @default(PENDING)
  isVoid Boolean @default(false)
  superiorUserId String?
  superiorNotifiedAt DateTime?
  
  decisionByUserId String?
  decisionNote String?
  decidedAt DateTime?
  endedByUserId String?
  endedAt DateTime?

  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, staffUserId])
  @@index([guildId, status])
  @@map("staff_absences")
}

model StaffVoiceSession {
  id String @id @default(cuid())
  guildId String
  staffUserId String
  channelId String
  channelName String?
  joinedAt DateTime
  leftAt DateTime?
  durationSeconds Int?

  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  
  @@index([guildId, staffUserId])
  @@index([joinedAt])
  @@map("staff_voice_sessions")
}

enum AbsenceStatus {
  PENDING
  ACKNOWLEDGED
  APPROVED
  REJECTED
  CANCELED
  ENDED
}

model StaffMeeting {
  id String @id @default(cuid())

  guildId String
  title String
  description String?
  scheduledAt DateTime
  endedAt     DateTime?
  status MeetingStatus @default(SCHEDULED)
  createdByUserId String
  
  discordMessageId String?
  discordEventId   String?
  
  // Champs pour les notifications de réunion
  notificationSentAt DateTime?      // Quand la notification de début a été envoyée
  notificationEndSentAt DateTime?  // Quand la notification de fin a été envoyée
  
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  presences StaffMeetingPresence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, scheduledAt])
  @@map("staff_meetings")
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model StaffMeetingPresence {
  id String @id @default(cuid())

  meetingId String
  staffUserId String
  status PresenceStatus @default(ABSENT)
  checkInAt DateTime?
  note String?

  meeting StaffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, staffUserId])
  @@map("staff_meeting_presences")
}

enum PresenceStatus {
  PRESENT
  EXCUSED
  ABSENT
}

model StaffManagerNote {
  id String @id @default(cuid())

  guildId String
  staffUserId String
  authorUserId String // StaffMember author
  content String
  
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation("ManagerNotesAbout", fields: [staffUserId], references: [id], onDelete: Cascade)
  author StaffMember @relation("ManagerNotesWritten", fields: [authorUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffUserId])
  @@index([guildId])
  @@map("staff_manager_notes")
}

model StaffPoll {
  id String @id @default(cuid())

  guildId String
  authorUserId String
  title String
  description String?
  isAnonymous Boolean @default(true)
  closesAt DateTime?
  status PollStatus @default(OPEN)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  author StaffMember @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  options StaffPollOption[]
  votes StaffPollVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@map("staff_polls")
}

enum PollStatus {
  OPEN
  CLOSED
}

model StaffPollOption {
  id String @id @default(cuid())

  pollId String
  text String
  sortOrder Int @default(0)

  poll StaffPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes StaffPollVote[]

  @@map("staff_poll_options")
}

model StaffPollVote {
  id String @id @default(cuid())

  pollId String
  optionId String
  staffUserId String
  weight Float @default(1.0)

  poll StaffPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option StaffPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, staffUserId])
  @@map("staff_poll_votes")
}

model StaffProcedure {
  id String @id @default(cuid())

  guildId String
  title String
  content String
  sortOrder Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reads StaffProcedureRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, sortOrder])
  @@map("staff_procedures")
}

model StaffProcedureRead {
  id String @id @default(cuid())

  procedureId String
  staffUserId String
  readAt DateTime @default(now())

  procedure StaffProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([procedureId, staffUserId])
  @@map("staff_procedure_reads")
}

enum CandidatureStatus {
  PENDING
  ORAL
  APPROVED
  REJECTED
  AUTO_REJECTED
}

enum OralResult {
  PENDING
  PASSED
  FAILED
}

model RecruitmentCandidature {
  id String @id @default(cuid())
  guildId String
  
  // Identifying fields (can be submitted or parsed)
  discordId String?
  username String?
  email String?
  
  status CandidatureStatus @default(PENDING)
  
  // The raw submission from Google Forms / Webhook
  data Json
  
  // Internal notes from staff
  notes String?
  
  // Rejection
  rejectionReason String?
  autoRejected    Boolean @default(false)
  autoRejectReason String?
  
  // Oral interview
  oralResult    OralResult?
  oralNotes     String?
  
  // Ticket Discord
  ticketChannelId String?
  
  // Staff linkage (after acceptance)
  assignedTutorId  String?
  staffMemberId    String?
  
  // Reapply cooldown
  reapplyAfter DateTime?
  
  // Who processed this candidature
  processedByUserId String?
  
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@index([guildId, discordId])
  @@map("recruitment_candidatures")
}

model Notification {
  id String @id @default(cuid())
  guildId String
  userId String // Utilisateur cible (Discord ID)

  title String
  message String
  type String @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  link String? // Lien vers la page concernée (ex: /absences)
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, isRead])
  @@map("notifications")
}

// ============================================================================
// ANALYTICS — STATISTIQUES SERVEUR
// ============================================================================

model GuildDailyStat {
  id String @id @default(cuid())

  guildId String
  dateKey String // YYYY-MM-DD

  totalMembers     Int @default(0)
  onlineMembers    Int @default(0)
  idleMembers      Int @default(0)
  dndMembers       Int @default(0)
  offlineMembers   Int @default(0)
  totalBots        Int @default(0)
  totalHumans      Int @default(0)

  messagesCount    Int @default(0)
  voiceMinutes     Int @default(0)
  voiceSessionsCount Int @default(0)

  membersJoined    Int @default(0)
  membersLeft      Int @default(0)

  sanctionsCount   Int @default(0)
  warnsCount       Int @default(0)
  kicksCount       Int @default(0)
  timeoutsCount    Int @default(0)
  bansCount        Int @default(0)

  activeMembers    Int @default(0) // Membres ayant envoyé >= 1 message
  activeVoiceMembers Int @default(0) // Membres ayant rejoint >= 1 vocal

  peakOnline       Int @default(0) // Pic de membres en ligne dans la journée
  peakVoice        Int @default(0) // Pic de membres en vocal simultanément

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey])
  @@index([guildId, dateKey])
  @@map("guild_daily_stats")
}

model ChannelDailyStat {
  id String @id @default(cuid())

  guildId   String
  channelId String
  dateKey   String // YYYY-MM-DD

  messagesCount Int @default(0)
  uniqueAuthors Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId, dateKey])
  @@index([guildId, dateKey])
  @@index([guildId, channelId])
  @@map("channel_daily_stats")
}

model MemberInvite {
  id String @id @default(cuid())

  guildId String
  userId  String // L'utilisateur qui a rejoint

  inviteCode  String?
  inviterId   String? // L'utilisateur qui a invité
  inviterTag  String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())
  leftAt   DateTime? // Quand l'utilisateur est parti

  @@index([guildId, inviterId])
  @@index([guildId, joinedAt])
  @@map("member_invites")
}

model GuildInvite {
  id String @id @default(cuid())
  
  guildId String
  code    String @unique
  
  inviterId   String?
  inviterTag  String?
  
  uses        Int @default(0)
  maxUses     Int?
  expiresAt   DateTime?
  
  isTemporary Boolean @default(false)
  isDeleted   Boolean @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  @@index([guildId, inviterId])
  @@map("guild_invites")
}

model GuildHourlyStat {
  id       String @id @default(cuid())

  guildId  String
  dateKey  String // YYYY-MM-DD
  hour     Int    // 0-23

  messagesCount Int @default(0)
  voiceMinutes  Int @default(0)
  joinsCount    Int @default(0)
  leavesCount   Int @default(0)
  reactionsCount Int @default(0)
  threadsCount  Int @default(0)
  
  onlineMembers Int @default(0)
  voiceMembers  Int @default(0)
  activeMembers Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, dateKey, hour])
  @@index([guildId, dateKey])
  @@map("guild_hourly_stats")
}

model MemberDailyStat {
  id       String @id @default(cuid())

  guildId  String
  userId   String
  dateKey  String // YYYY-MM-DD

  messagesCount    Int @default(0)
  voiceMinutes     Int @default(0)
  reactionsCount   Int @default(0)
  threadsCreated   Int @default(0)
  repliesCount     Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId, dateKey])
  @@index([guildId, dateKey])
  @@index([guildId, userId])
  @@map("member_daily_stats")
}
model TutoringConfig {
  guildId String @id
  reportIntervalDays Int @default(14) // Par défaut toutes les 2 semaines
  reminderDaysBefore Int @default(2) // Rappel 2 jours avant
  minTestDays Int @default(14) // Temps minimum en test avant validation
  showVocalActivity Boolean @default(true)
  showAbsences Boolean @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tutoring_configs")
}

model TutoringItem {
  id String @id @default(cuid())
  guildId String
  category String // e.g., "Outils", "Savoir", "Accès"
  title String
  description String?
  sortOrder Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  progress TutoringChecklistProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, sortOrder])
  @@map("tutoring_items")
}

enum TutoringItemState {
  UNCHECKED
  KNOWN
  ACQUIRED
}

model TutoringChecklistProgress {
  id String @id @default(cuid())
  testingPeriodId String
  itemId String
  state TutoringItemState @default(UNCHECKED)
  completedAt DateTime?
  completedByUserId String? // Tutor who checked it

  testingPeriod TestingPeriod @relation(fields: [testingPeriodId], references: [id], onDelete: Cascade)
  item TutoringItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testingPeriodId, itemId])
  @@map("tutoring_checklist_progress")
}

model TutoringLog {
  id String @id @default(cuid())
  testingPeriodId String
  content String
  date DateTime @default(now())

  testingPeriod TestingPeriod @relation(fields: [testingPeriodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testingPeriodId, date])
  @@map("tutoring_logs")
}

// ============================================================================
// GESTION CENTRALISÉE DU DASHBOARD
// ============================================================================

model DashboardFeatureConfig {
  id String @id @default(cuid())

  guildId String
  featureKey String // ex: "daily_algo", "youtube", "digest", "sanctions", etc.
  featureName String // Nom lisible

  enabled Boolean @default(true)
  
  // Configuration Discord
  channelId String? // Salon principal pour la feature
  secondaryChannelId String? // Salon secondaire si nécessaire
  requiredRoleId String? // Rôle requis pour accéder
  notificationRoleId String? // Rôle à mentionner pour les notifications

  // Configuration notifications
  notifyViaDiscordChannel Boolean @default(true) // Notifier sur Discord
  notifyViaDM Boolean @default(false) // Notifier en MP
  notifyOnlyStaffRoles Boolean @default(false) // Notifier seulement les rôles staff spécifiés

  // Logging et suivi
  loggingEnabled Boolean @default(true)
  userActivityTracking Boolean @default(true) // Suivre les activités des utilisateurs

  // Configuration supplémentaire (JSON pour flexibilité)
  metadata Json? // Pour stocker des config spécifiques à chaque feature

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  roleAccess DashboardRoleAccess[]
  roleAccessByRole DashboardFeatureRoleAccess[]
  notificationTargets NotificationTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, featureKey])
  @@index([guildId, enabled])
  @@map("dashboard_feature_configs")
}

model DashboardFeatureRoleAccess {
  id String @id @default(cuid())

  guildId String
  featureConfigId String
  roleId String

  canView Boolean @default(false)
  canModerate Boolean @default(false)
  canConfigure Boolean @default(false)
  canDelete Boolean @default(false)
  metadata Json?

  featureConfig DashboardFeatureConfig @relation(fields: [featureConfigId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([featureConfigId, roleId])
  @@index([guildId, featureConfigId])
  @@map("dashboard_feature_role_accesses")
}

model DashboardRoleAccess {
  id String @id @default(cuid())

  guildId String
  featureConfigId String
  staffRoleLevel Int // Niveau du rôle staff (0 = Helper, 1 = Mod, 2 = Admin, etc.)
  
  canView Boolean @default(false)
  canModerate Boolean @default(false)
  canConfigure Boolean @default(false)
  canDelete Boolean @default(false)
  metadata Json?

  featureConfig DashboardFeatureConfig @relation(fields: [featureConfigId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([featureConfigId, staffRoleLevel])
  @@index([guildId, featureConfigId])
  @@map("dashboard_role_accesses")
}

model NotificationTarget {
  id String @id @default(cuid())

  guildId String
  featureConfigId String
  
  targetType NotificationTargetType // DISCORD_CHANNEL, DISCORD_ROLE, DM_STAFF_ROLE, EMAIL
  targetId String? // ID du rôle, channel, ou autre selon le type
  
  enabled Boolean @default(true)

  featureConfig DashboardFeatureConfig @relation(fields: [featureConfigId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, featureConfigId])
  @@map("notification_targets")
}

enum NotificationTargetType {
  DISCORD_CHANNEL
  DISCORD_ROLE
  DM_STAFF_ROLE
  EMAIL
}

// ============================================================================
// SYSTEME D'ADMINISTRATION GLOBALE
// ============================================================================

model GlobalAdmin {
  userId String @id
  addedBy String
  createdAt DateTime @default(now())

  @@map("global_admins")
}

model GlobalBlacklist {
  userId String @id
  reason String?
  addedBy String
  createdAt DateTime @default(now())

  @@map("global_blacklist")
}

model BotErrorLog {
  id String @id @default(cuid())
  message String
  stack String?
  source String? // ex: "Command /algo", "Event messageCreate"
  createdAt DateTime @default(now())

  @@map("bot_error_logs")
}

model BotGlobalConfig {
  key String @id // ex: "MAINTENANCE_MODE"
  value String // JSON stringified value
  updatedAt DateTime @updatedAt

  @@map("bot_global_config")
}

model DashboardCommandUsage {
  id String @id @default(cuid())
  guildId String
  commandName String
  userId String?
  count Int @default(1)
  lastUsedAt DateTime @default(now())

  @@unique([guildId, commandName, userId])
  @@index([guildId, commandName])
  @@map("dashboard_command_usages")
}
