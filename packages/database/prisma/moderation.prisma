enum SanctionType {
  WARN
  KICK
  TIMEOUT
  TEMP_BAN
  BAN
  SOFTBAN
}

enum SanctionStatus {
  ACTIVE
  RESOLVED
  FAILED
}

enum CodePoliceRuleCategory {
  SIGNAL
  DANGER
  LANGUAGE_FEEDBACK
}

enum CodePoliceMatchType {
  EXACT
  REGEX
}

enum CodePoliceSeverity {
  INFO
  WARNING
  DANGER
}


enum LinkedAccountType {
  MANUAL
  AUTOMATIC
}

enum LinkedAccountStatus {
  PENDING
  VALIDATED
  REJECTED
}

model CodePoliceRule {
  id String @id @default(cuid())

  key String @unique
  guildId String?

  category CodePoliceRuleCategory
  matchType CodePoliceMatchType @default(EXACT)
  language String?
  pattern String
  label String
  feedback String
  severity CodePoliceSeverity @default(WARNING)
  enabled Boolean @default(true)

  guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("code_police_rules")
  @@index([guildId, category])
  @@index([category, enabled])
  @@index([language])
}


model LinkedAccount {
  id String @id @default(cuid())
  guildId String

  user1Id String
  user2Id String

  type LinkedAccountType @default(MANUAL)
  status LinkedAccountStatus @default(VALIDATED)

  reason String?
  metadata Json? // Pour stocker les preuves de détection

  linkedByUserId String? // Si manuel, qui l'a fait

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, user1Id, user2Id])
  @@index([guildId, user1Id])
  @@index([guildId, user2Id])
  @@map("linked_accounts")
}




model Sanction {
  id String @id @default(cuid())

  guildId String
  type SanctionType
  status SanctionStatus @default(ACTIVE)

  targetUserId String
  targetTag String?
  moderatorUserId String
  moderatorTag String?

  reason String
  durationSeconds Int?
  expiresAt DateTime?
  nextActionAt DateTime?

  resolvedAt DateTime?
  resolutionNote String?
  lastReportReminderAt DateTime?
  managerReportEscalatedAt DateTime?

  sanctionTableId String?
  sanctionTable   SanctionTable? @relation(fields: [sanctionTableId], references: [id], onDelete: SetNull)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reports SanctionReport[]
  evidenceFiles SanctionEvidenceFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, status, type])
  @@index([status, nextActionAt])
  @@index([sanctionTableId])
  // Recherches par membre à travers plusieurs serveurs (casier + casier cross-serveur)
  @@index([targetUserId, createdAt])
  @@map("sanctions")
}

model SanctionTable {
  id        String   @id @default(cuid())
  guildId   String
  name      String   // Unique per guild, e.g. "Spam", "Insultes"
  
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  tiers     SanctionTier[]
  sanctions Sanction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@map("sanction_tables")
}

model SanctionTier {
  id              String       @id @default(cuid())
  tableId         String
  level           Int          // 1, 2, 3...
  action          SanctionType
  durationSeconds Int?
  customReason    String?
  
  table           SanctionTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tableId, level])
  @@map("sanction_tiers")
}

// Fichiers de preuve uploadés directement (captures d'écran, PDF, courtes vidéos)
// pour les rapports de sanction. Les octets sont stockés en base (comme les
// transcriptions HTML de `Transcript`) car le volume est strictement plafonné
// côté application (taille/fichier, nombre/sanction, quota cumulé/serveur).
model SanctionEvidenceFile {
  id String @id @default(cuid())

  guildId String
  sanctionId String?

  fileName String
  mimeType String
  size Int
  data Bytes

  uploadedByUserId String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sanction Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([guildId, sanctionId])
  @@index([guildId, createdAt])
  @@map("sanction_evidence_files")
}

model SanctionReport {
  id String @id @default(cuid())

  guildId String
  sanctionId String?

  staffPseudo String
  incidentAt DateTime
  memberPseudo String
  memberReference String

  sanctionType SanctionType
  sanctionDurationLabel String?
  brokenRules String
  detailedReason String
  evidenceLinks String[] @default([])
  additionalNotes String?

  createdByUserId String
  createdByTag String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sanction Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, createdAt])
  @@index([guildId, sanctionType])
  @@index([sanctionId])
  @@map("sanction_reports")
}
