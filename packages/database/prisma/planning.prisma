// ============================================================================
// SYSTÈME DE PLANNING & AGENDA (Tâches, Appels/Calls)
// ============================================================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model StaffTask {
  id          String       @id @default(cuid())
  guildId     String
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  assigneeId  String       // ID du StaffMember assigné
  creatorId   String       // ID du StaffMember créateur

  assignee    StaffMember  @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator     StaffMember  @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  guild       Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([guildId, assigneeId])
  @@map("staff_tasks")
}

enum CallStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELED
}

model StaffCall {
  id               String            @id @default(cuid())
  guildId          String
  title            String
  description      String?
  scheduledAt      DateTime
  endedAt          DateTime?
  status           CallStatus        @default(SCHEDULED)

  creatorId        String            // ID du StaffMember créateur

  channelMode      String            // "CREATE_NEW", "EXISTING"
  channelType      String?           // "VOICE", "STAGE", "THREAD"
  discordChannelId String?           // ID du salon/thread associé
  isTempChannel    Boolean           @default(true)

  creator          StaffMember       @relation("CreatedCalls", fields: [creatorId], references: [id], onDelete: Cascade)
  guild            Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  invitees         StaffCallInvitee[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([guildId, scheduledAt])
  @@map("staff_calls")
}

model StaffCallInvitee {
  id           String      @id @default(cuid())
  callId       String
  staffUserId  String      // ID cuid du StaffMember

  joinedAt     DateTime?   // Si et quand le membre a rejoint le call

  call         StaffCall   @relation(fields: [callId], references: [id], onDelete: Cascade)
  staffMember  StaffMember @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([callId, staffUserId])
  @@map("staff_call_invitees")
}
