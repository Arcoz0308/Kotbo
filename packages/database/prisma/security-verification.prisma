enum VerificationMode {
  DM
  EMBED
}

enum VerificationAction {
  AUTO_LINK
  NOTIFY_STAFF
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FLAGGED
  EXPIRED
}

enum VerificationLevel {
  LOW
  MEDIUM
  HIGH
}

enum VerificationFallbackKind {
  THREAD
  TICKET
}

model SecurityVerification {
  id String @id @default(cuid())

  guildId String
  userId  String
  token   String @unique

  status    VerificationStatus @default(PENDING)
  level     VerificationLevel  @default(HIGH)
  appealId  String?
  ipAddress String?
  deviceInfo Json?
  verifiedDiscordId String?
  verifiedAt        DateTime?

  email             String?
  connections       Json?
  guilds            Json?
  userFetched       Json?

  duplicateDetected   Boolean @default(false)
  duplicateUserId     String?
  duplicateEvidence   Json?

  // Salon de repli créé quand le MP n'a pas pu être délivré (thread privé ou ticket)
  fallbackChannelId String?
  fallbackKind      VerificationFallbackKind?

  createdAt DateTime @default(now())
  expiresAt DateTime

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([token])
  @@index([guildId, status])
  @@index([expiresAt])
  @@index([appealId])
  @@map("security_verifications")
}
