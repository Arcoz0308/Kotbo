// ============================================================================
// SYSTEME D'ADMINISTRATION GLOBALE
// ============================================================================

model GlobalAdmin {
  userId String @id
  addedBy String
  createdAt DateTime @default(now())

  @@map("global_admins")
}

model ActivationCode {
  id            String    @id @default(cuid())
  code          String    @unique
  createdAt     DateTime  @default(now())
  createdById   String
  usedAt        DateTime?
  usedByGuildId String?   @unique
  isActive      Boolean   @default(true)

  @@map("activation_codes")
}

model GlobalBlacklist {
  userId String @id
  reason String?
  addedBy String
  createdAt DateTime @default(now())

  @@map("global_blacklist")
}

model BotErrorLog {
  id String @id @default(cuid())
  message String
  stack String?
  source String? // ex: "Command /algo", "Event messageCreate"
  createdAt DateTime @default(now())

  @@map("bot_error_logs")
}

model BotGlobalConfig {
  key String @id // ex: "MAINTENANCE_MODE"
  value String // JSON stringified value
  updatedAt DateTime @updatedAt

  @@map("bot_global_config")
}

model BroadcastLog {
  id String @id @default(cuid())

  sentBy       String
  title        String
  message      String
  color        String    @default("#5865F2")
  thumbnailUrl String?
  imageUrl     String?
  footerText   String?
  target       String    @default("ALL") // ALL, ACTIVATED, CUSTOM
  targetGuilds String[]  @default([])
  channelPref  String    @default("NEWS") // NEWS, PUBLIC, STAFF, FALLBACK

  successCount Int       @default(0)
  failCount    Int       @default(0)
  totalTargeted Int      @default(0)

  createdAt DateTime @default(now())

  @@map("broadcast_logs")
}
