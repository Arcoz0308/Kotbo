# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# YouTube
NATHAN_YOUTUBE_CHANNEL_ID=

# Logging
LOG_LEVEL=info

# Traduction locale (LibreTranslate)
# En Docker Compose, LibreTranslate est heberge localement et injecte automatiquement.
# En execution hors compose, adapte cette URL.
LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Timeout des appels traduction (en millisecondes)
TRANSLATION_TIMEOUT_MS=7000