# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# YouTube
NATHAN_YOUTUBE_CHANNEL_ID=

# Logging
LOG_LEVEL=info

# Translation fallback (optionnel)
# En Docker Compose, LibreTranslate est heberge localement et injecte automatiquement.
# En execution hors compose, tu peux pointer une autre instance LibreTranslate.
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Cooldown anti-spam apres quota Google (en millisecondes)
GOOGLE_TRANSLATE_QUOTA_COOLDOWN_MS=600000