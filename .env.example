# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# YouTube
NATHAN_YOUTUBE_CHANNEL_ID=

# Logging
LOG_LEVEL=info

# Dashboard / Frontend
# URL publique du backend API (sans slash final)
# Exemple local: http://localhost:8787
# Exemple prod: https://api.votre-domaine.tld
VITE_API_URL=http://localhost:8787

# URL publique du dashboard pour les redirections OAuth
DASHBOARD_URL=http://localhost:5173

# Optionnel: active le mode strict qui bloque le démarrage si OAuth incomplet
# DASHBOARD_OAUTH_STRICT=false

# Traduction locale (LibreTranslate)
# En Docker Compose, LibreTranslate est heberge localement et injecte automatiquement.
# En execution hors compose, adapte cette URL.
LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# Timeout des appels traduction (en millisecondes)
TRANSLATION_TIMEOUT_MS=7000