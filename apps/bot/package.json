{
  "name": "@kotbo/bot",
  "version": "1.2.7",
  "private": true,
  "scripts": {
    "prestart": "bun run quality:gate",
    "dev": "bun run --watch src/index.ts",
    "dev:safe": "bun run quality:gate && bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:safe": "bun run quality:gate && bun run src/index.ts",
    "deploy-commands": "bun run src/deploy-commands.ts",
    "test:unit": "bun test src/tests",
    "test:coverage": "bun test --coverage src/tests",
    "coverage:gate": "bun run scripts/coverage-gate.ts",
    "test:watch": "bun test --watch src/tests",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "quality:gate": "bun run test:unit && bun run coverage:gate"
  },
  "dependencies": {
    "@kotbo/database": "workspace:*",
    "@napi-rs/canvas": "^0.1.65",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.0.0",
    "@prisma/client-runtime-utils": "7.6.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "franc-min": "^6.2.0",
    "lru-cache": "11.0.2",
    "node-cron": "^3.0.3",
    "p-limit": "5.0.0",
    "rss-parser": "^3.13.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.2"
  }
}
