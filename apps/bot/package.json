{
  "name": "@kotbo/bot",
  "version": "7.12",
  "private": true,
  "scripts": {
    "migrate:deploy": "cd ../.. && bun run db:migrate:deploy",
    "prestart": "bun run migrate:deploy && bun run quality:gate",
    "dev": "bun run --watch src/launcher.ts",
    "dev:safe": "bun run quality:gate && bun run --watch src/launcher.ts",
    "start": "bun run src/launcher.ts",
    "start:safe": "bun run quality:gate && bun run src/launcher.ts",
    "deploy-commands": "bun run src/deploy-commands.ts",
    "test:unit": "bun test src/tests",
    "test:coverage": "bun test --coverage src/tests",
    "coverage:gate": "bun run scripts/coverage-gate.ts",
    "test:watch": "bun test --watch src/tests",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit",
    "quality:gate": "bun run test:unit && bun run coverage:gate"
  },
  "dependencies": {
    "@kotbo/database": "workspace:*",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "7.6.0",
    "@sentry/bun": "^10.53.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.76.11",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "franc-min": "^6.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "11.0.2",
    "node-cron": "^3.0.3",
    "p-limit": "5.0.0",
    "pg": "^8.21.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
